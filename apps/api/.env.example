# PORT — Required — Render assigned port — 8080
# DATABASE_URL — Required in shared deployment — PostgreSQL provider connection string
# CORS_ORIGIN — Required — deployed Vercel origin — https://your-app.vercel.app
# SESSION_SECRET — Required — 32+ random characters from password manager
# SENTRY_DSN — Optional — Sentry project settings
# SANDBOX_PROVIDER_URL — Optional — isolated execution provider API
# SANDBOX_PROVIDER_TOKEN — Optional — provider dashboard secret
PORT=8080
DATABASE_URL=postgresql://orbit:orbit@localhost:5432/orbit
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-32-random-characters
SENTRY_DSN=
SANDBOX_PROVIDER_URL=
SANDBOX_PROVIDER_TOKEN=
